APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

BACKEND_PORT=8080
FRONTEND_PORT=3000
RAG_API_PORT=9000
LLM_ENGINE_PORT=8000
EMBEDDING_PORT=9100
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
KIBANA_PORT=5601

ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

LLM_MODEL_NAME=mistral-7b-instruct-v0.2-q4_k_m
LLM_CONTEXT_WINDOW=12288

EMBEDDING_MODEL_NAME=bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768

DUCKDUCKGO_REQUEST_INTERVAL_SECONDS=2.0
DUCKDUCKGO_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Provide filesystem path or download URL if preloading models
LLM_MODEL_URL=https://huggingface.co/TheBloke/Mistral-7B-Instruct-v0.2-GGUF/resolve/main/mistral-7b-instruct-v0.2.Q4_K_M.gguf
EMBEDDING_MODEL_NAME_OR_PATH=BAAI/bge-base-en-v1.5

# WireMock / testing configuration
WIREMOCK_PORT=8089

FRONTEND_VITE_API_BASE_URL=http://localhost:8080/api/v1

RAG_HOST=0.0.0.0
RAG_PORT=9000
RAG_RELOAD=1
RAG_LLM_ENGINE_URL=http://llm-engine:8000
RAG_EMBEDDING_SERVICE_URL=http://embedding-worker:9100
RAG_SEARCH_AGENT_URL=http://search-agent:9205
RAG_ELASTICSEARCH_URL=http://elasticsearch:9200
RAG_HTTP_TIMEOUT=180
RAG_HTTP_CONNECT_TIMEOUT=5
RAG_INDEX_USER_PROFILES=user_profiles
RAG_INDEX_KNOWLEDGE_SNAPSHOTS=knowledge_snapshots
RAG_INDEX_LEARNING_RESOURCES=learning_resources
RAG_INDEX_DEPENDENCY_GRAPH=dependency_graph
RAG_INDEX_SESSION_INTERACTIONS=session_interactions
RAG_INDEX_SESSIONS=sessions
LLM_THREADS=8
LLM_BATCH_SIZE=512
LLM_ACCELERATION_MODE=gpu
LLM_GPU_LAYERS=32
LLM_SERVER_HOST=0.0.0.0
LLM_SERVER_PORT=8000
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=/models
ELASTICSEARCH_BOOTSTRAP=true
SEARCH_AGENT_PORT=9205
RAG_GRADING_PROFILE=default
RAG_GRADING_CONFIG_PATH=/usr/src/app/config/grading_profiles.yaml
RAG_LAB_TEMPLATE_DIR=/usr/src/app/lab_templates
RAG_LAB_OUTPUT_ROOT=
RAG_LAB_AUTO_WRITE=0
FLOW_LOG_PATH=/shared-logs/teacher-flow.log
FLOW_EVENT_TOKEN=teacher-flow-events-local
FLOW_EVENT_CACHE_STORE=flow_events
FLOW_EVENT_BUFFER_SIZE=40
FLOW_EVENT_RETENTION_SECONDS=900
FLOW_EVENT_STREAM_POLL_INTERVAL_MS=500
FLOW_EVENT_STREAM_TIMEOUT_SECONDS=25
HSA_OVERRIDE_GFX_VERSION=10.3.0
HIP_VISIBLE_DEVICES=0
