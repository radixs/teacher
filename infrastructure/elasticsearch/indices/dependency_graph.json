{
  "index_patterns": ["dependency_graph"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "concept_id": {"type": "keyword"},
        "session_id": {"type": "keyword"},
        "concept_name": {"type": "text"},
        "prerequisites": {"type": "keyword"},
        "difficulty": {"type": "integer"},
        "phase": {"type": "keyword"},
        "summary": {"type": "text"},
        "goal": {"type": "text"},
        "confidence": {"type": "float"},
        "exercise": {"type": "text"},
        "resources": {
          "type": "nested",
          "dynamic": true,
          "properties": {
            "title": {"type": "text"},
            "url": {"type": "keyword"},
            "type": {"type": "keyword"}
          }
        },
        "created_at": {"type": "date"},
        "updated_at": {"type": "date"}
      }
    }
  }
}
