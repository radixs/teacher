{
  "index_patterns": ["session_interactions"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "session_id": {"type": "keyword"},
        "turn": {"type": "integer"},
        "role": {"type": "keyword"},
        "content": {"type": "text"},
        "phase": {"type": "keyword"},
        "embedding": {
          "type": "dense_vector",
          "dims": 768,
          "index": true,
          "similarity": "cosine"
        },
        "metadata": {
          "type": "object",
          "enabled": true,
          "dynamic": true
        },
        "created_at": {"type": "date"}
      }
    }
  }
}
