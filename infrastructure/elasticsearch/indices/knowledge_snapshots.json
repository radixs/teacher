{
  "index_patterns": ["knowledge_snapshots"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index": {
        "knn": true
      }
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "session_id": {"type": "keyword"},
        "topic": {"type": "text"},
        "content": {"type": "text"},
        "embedding": {
          "type": "dense_vector",
          "dims": 768,
          "index": true,
          "similarity": "cosine"
        },
        "confidence": {"type": "float"},
        "created_at": {"type": "date"}
      }
    }
  }
}
